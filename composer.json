{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "integra360/integra-360",
    "type": "project",
    "description": "Integra 360: plataforma SaaS de gestión operativa y normativa para empresas de transporte en Colombia.",
    "keywords": [
        "laravel",
        "saas",
        "pesv",
        "transporte"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.9",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.12",
        "laravel-lang/common": "^6.8",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\Core\\": "modules/Core/src/",
            "Modules\\Core\\Database\\Factories\\": "modules/Core/database/factories/",
            "Modules\\Core\\Database\\Seeders\\": "modules/Core/database/seeders/",
            "Modules\\Pesv\\": "modules/Pesv/src/",
            "Modules\\Pesv\\Database\\Factories\\": "modules/Pesv/database/factories/",
            "Modules\\Pesv\\Database\\Seeders\\": "modules/Pesv/database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "@composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "lint": "@php vendor/bin/pint --test",
        "format": "@php vendor/bin/pint",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G --no-progress",
        "deptrac": "@php vendor/bin/deptrac analyse --no-progress",
        "check": [
            "@lint",
            "@analyse",
            "@deptrac",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "check": "Pint (verificación), Larastan, Deptrac y Pest: lo mismo que ejecuta GitHub Actions.",
        "lint": "Verifica el estilo de código con Pint sin modificar archivos.",
        "format": "Corrige el estilo de código con Pint.",
        "analyse": "Análisis estático con Larastan (nivel 6).",
        "deptrac": "Verifica las reglas de dependencia entre módulos."
    }
}
