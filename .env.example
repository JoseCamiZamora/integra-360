# =============================================================================
# Integra 360 · Variables de entorno
# -----------------------------------------------------------------------------
# Copia este archivo a .env (cp .env.example .env) y ejecuta
# `php artisan key:generate`. NUNCA subas el archivo .env al repositorio.
# En Laravel Cloud estas variables se definen en el panel del entorno; ver
# docs/deploy.md para la lista de variables obligatorias en producción.
# =============================================================================

# --- Aplicación --------------------------------------------------------------
APP_NAME="Integra 360"
# local | testing | production
APP_ENV=local
# Se genera con `php artisan key:generate`. En producción la pone Laravel Cloud.
APP_KEY=
# Siempre false en producción.
APP_DEBUG=true
# Herd: http://integra-360.test · Sail: http://localhost
APP_URL=http://integra-360.test

# --- Configuración regional (Colombia) ---------------------------------------
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/Bogota

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# --- Registros ---------------------------------------------------------------
# En Laravel Cloud usar LOG_CHANNEL=stderr para verlos en el panel.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de datos (MySQL 8; nunca SQLite ni MariaDB) ------------------------
# Herd en Windows: MySQL 8 escucha en el 3307 porque XAMPP (MariaDB) ocupa el
# 3306. Con Sail: DB_HOST=mysql y DB_PORT=3306.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=integra360
DB_USERNAME=integra
DB_PASSWORD=
# Las pruebas (Pest) usan la base integra360_testing con este mismo host y
# usuario; el nombre está fijado en phpunit.xml.

# --- Sesión, caché y colas (sin Redis en el piloto) --------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
CACHE_STORE=database
# CACHE_PREFIX=
# Toda tarea lenta (correos, imágenes) va en cola con el driver database.
QUEUE_CONNECTION=database

# --- Archivos ----------------------------------------------------------------
# Local: `local` (o `s3` apuntando a MinIO). Producción: SIEMPRE `s3`; la
# aplicación se niega a arrancar en producción con un disco local, porque el
# disco de Laravel Cloud es efímero.
FILESYSTEM_DISK=local

# Almacenamiento compatible con S3 (bucket de Laravel Cloud, AWS o MinIO).
# Laravel Cloud inyecta estas variables al adjuntar el bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Solo para MinIO u otros servicios compatibles, p. ej. http://127.0.0.1:9000
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Correo ------------------------------------------------------------------
# En local los correos se escriben en storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="notificaciones@integra360.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Acceso provisional (se reemplaza por autenticación real en I360-01) -----
# Mientras no exista login, /app y /conductor solo se abren en entornos
# locales o si esta variable es true. En producción déjala en false.
PROVISIONAL_ACCESS_ENABLED=false

# --- Sail (solo si usas Docker; ver README.md) ------------------------------
# Con Sail: DB_HOST=mysql, DB_PORT=3306, APP_URL=http://localhost y una
# DB_PASSWORD no vacía. FORWARD_DB_PORT expone MySQL al equipo: usa 3308
# si XAMPP (3306) o Herd (3307) ya ocupan esos puertos.
# APP_PORT=80
# FORWARD_DB_PORT=3308
# WWWUSER=1000
# WWWGROUP=1000

VITE_APP_NAME="${APP_NAME}"
